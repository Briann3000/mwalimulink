# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example

# Outreach Campaign Data & Opt-outs (CRITICAL)
data/campaign_tracker.json
data/unsubscribes.json
data/*.json
.campaign_tracker.json
campaign_tracker.json

# Quarantined Drafts & Old Snapshots
_archive/
_archive*/
_local_archive/
_local_archive*/
_local_archive_do_not_upload/

# User Uploads (CVs, Resumes, Personal PDFs)
uploads/*
!uploads/.gitkeep

# Large SQLite Database Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# Scratch & Local Test Harnesses (CRITICAL - Never deploy to production)
scratch/
*.bak
*.tmp

# Database dumps & SQL exports / Archives
*.sql
*.zip
*.tar
*.tar.gz
*.gz
mwalimu_prod_dump.sql
mwalimu_mysql_dump.sql

# Server Logs & Errors
error_log
views/error_log
*.log

# OS & IDE junk
.DS_Store
Thumbs.db
.vscode/
.idea/