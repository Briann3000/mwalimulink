# Application Environment
APP_ENV=production
APP_URL=https://mwalimu.info
APP_DEBUG=false

# Database Connection (sqlite or mysql)
DB_CONNECTION=sqlite
DB_PATH=data/mwalimu.db

# MySQL Settings (used when DB_CONNECTION=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mwalimu
DB_USERNAME=root
DB_PASSWORD=

# IntaSend Payment Gateway Credentials
INTASEND_PUBLISHABLE_KEY=ISPubKey_live_your_key_here
INTASEND_PUBLIC_KEY=ISPubKey_live_your_key_here
INTASEND_SECRET_KEY=ISSecretKey_live_your_key_here
INTASEND_WEBHOOK_SECRET=your_webhook_secret_here
INTASEND_TEST_MODE=false
INTASEND_CURRENCY=KES
INTASEND_SUBSCRIPTION_AMOUNT=1000

# Mail / Communication Settings (Resend API & SMTP)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=infomwalimulink@gmail.com
MAIL_FROM_NAME="Mwalimu Link"

# SMTP Fallback Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=infomwalimulink@gmail.com
SMTP_PASSWORD=your_app_password_here

# Default Admin Credentials
ADMIN_EMAIL=infomwalimulink@gmail.com
ADMIN_PASSWORD=your_admin_password_here

# Groq Cloud API for AI CV Polishing
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

