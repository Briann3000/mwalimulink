# Application Environment
APP_ENV=production
APP_URL=https://mwalimu.info
APP_DEBUG=false

# Database Connection (sqlite or mysql)
DB_CONNECTION=sqlite
DB_PATH=data/mwalimu.db

# MySQL Settings (used when DB_CONNECTION=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mwalimu
DB_USERNAME=root
DB_PASSWORD=

# IntaSend Payment Gateway Credentials
INTASEND_PUBLIC_KEY=ISPubKey_live_your_key_here
INTASEND_SECRET_KEY=ISSecretKey_live_your_key_here
INTASEND_TEST_MODE=false
INTASEND_CURRENCY=KES
INTASEND_SUBSCRIPTION_AMOUNT=1000

# Mail / SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=themwalimulink@gmail.com
SMTP_PASSWORD=your_new_app_password_here
MAIL_FROM_ADDRESS=themwalimulink@gmail.com
MAIL_FROM_NAME="Mwalimu Link"

# Default Admin Credentials
ADMIN_EMAIL=admin@mwalimu.info
ADMIN_PASSWORD=Kenya@254
